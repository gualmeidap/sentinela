# Build Maven
target/
infra/build/
*.jar
*.war

# pagina/src/main/resources e uma copia gerada de web/ por
# infra/preparar_pagina.py -- nunca editada a mao, nunca versionada.
pagina/src/main/resources/*.html
pagina/src/main/resources/*.css
pagina/src/main/resources/*.js

# --- Restricao do projeto ---------------------------------------------------
# A instancia privada nunca entra no repositorio: nem URL, nem nome de sistema,
# nem IP. Qualquer arquivo de configuracao local fica de fora por padrao.
# O briefing nao e versionado: o README centraliza o que e publico, e o
# CLAUDE.local.md guarda a versao com os identificadores reais.
CLAUDE.md
CLAUDE.local.md
application-local.yml
application-local.yaml
application-local.properties
application-privado.*
*.local.yml
*.local.yaml
*.local.properties
.env
.env.*
alvos*.yml
alvos*.json
alvos*.properties
!alvos.exemplo.properties
# O publicador de auditoria le a base de um sistema real: o caminho desse
# banco e o id da aplicacao ficam so na config local, junto do cursor de
# leitura. O .exemplo, com valores ficticios, e o que fica versionado.
publicador-auditoria/config.json
publicador-auditoria/cursor.json
