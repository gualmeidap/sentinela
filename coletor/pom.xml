<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.sentinela</groupId>
  <artifactId>sentinela-coletor</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>sentinela-coletor</name>
  <description>Verifica a cada 5 minutos se cada sistema monitorado responde</description>

  <!--
    Projeto independente do api/, e nao um modulo dele. As duas pecas nao
    compartilham codigo de proposito: elas se encontram no banco e em nenhum
    outro lugar. Um jar comum entre as duas viraria, com o tempo, um caminho
    de acoplamento por onde a mudanca de uma quebra a outra.

    Sem spring-boot-starter-parent, cada versao e declarada a mao aqui. Sao as
    mesmas que o api/ ja resolve, para nao haver duas combinacoes de
    biblioteca de teste no mesmo repositorio.
  -->

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>6.0.3</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <aws.sdk.version>2.54.13</aws.sdk.version>
    <slf4j.version>2.0.19</slf4j.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws.sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- O SDK ainda declara o slf4j 1.7. A 2.x e compativel e e a linha
           mantida hoje; fixar aqui evita ficar com a versao antiga por
           heranca. -->
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!--
    Uma dependencia de execucao, e so uma: o cliente do DynamoDB.

    Ate o passo 4 este projeto nao tinha nenhuma, porque cliente HTTP, leitura
    de configuracao e concorrencia ja vem no JDK 21. Para gravar no DynamoDB
    nao ha como fugir do SDK da AWS: o protocolo exige assinatura SigV4, e
    implementar isso a mao seria trocar 20 MB de biblioteca testada por
    criptografia caseira em codigo que roda sem ninguem olhando.

    O que da para fazer e cortar o supérfluo. O SDK traz por padrao dois
    clientes HTTP (Netty e Apache), ambos servidores de rede completos; a
    Lambda faz poucas chamadas sincronas e o cliente simples do JDK basta.
    Cada jar a menos e tempo de cold start a menos, em toda invocacao, para
    sempre.
  -->
  <dependencies>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>dynamodb</artifactId>
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache5-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
    </dependency>

    <!--
      O SDK registra o que faz via slf4j, mas slf4j sozinho nao imprime nada:
      ele precisa de uma implementacao. Sem ela o programa avisa na saida e
      descarta as mensagens em silencio.

      Na Lambda isso importa: se o DynamoDB recusar escrita por excesso de
      capacidade, o SDK avisa por aqui, e sem implementacao esse aviso nunca
      chegaria ao CloudWatch.
    -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
      </plugin>
      <!--
        Empacota o coletor e suas dependencias num jar so.

        Sem isto, "java -jar" enxerga apenas o que esta dentro do arquivo e o
        SDK fica de fora: o programa sobe, imprime a primeira linha e morre com
        NoClassDefFoundError na hora de gravar. Enquanto o projeto nao tinha
        dependencia nenhuma o problema nao existia.

        A Lambda tambem espera um artefato autocontido, entao o mesmo jar serve
        para os dois usos.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <!-- Junta os arquivos META-INF/services de todos os jars. Sem
                     este, um sobrescreve o outro e o SDK nao acha suas
                     implementacoes em tempo de execucao. -->
                <transformer
                  implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <!-- O SDK da AWS registra interceptadores num arquivo de texto
                     que precisa ser concatenado, e nao substituido. -->
                <transformer
                  implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>software/amazon/awssdk/global/handlers/execution.interceptors</resource>
                </transformer>
                <transformer
                  implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.sentinela.coletor.Coletor</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <!-- Assinaturas dos jars originais nao valem para o jar
                       combinado; deixa-las quebra a verificacao na subida. -->
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
