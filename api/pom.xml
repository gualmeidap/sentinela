<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Herdar do starter-parent do Spring Boot fixa as versoes de todas as
       dependencias do ecossistema. Por isso as <dependency> abaixo nao tem
       <version>: quem decide e o parent. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>com.sentinela</groupId>
  <artifactId>sentinela-api</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>sentinela-api</name>
  <description>API de leitura do portal de observabilidade</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <aws.sdk.version>2.54.13</aws.sdk.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- O BOM da AWS alinha as versoes de todos os modulos do SDK entre si,
           do mesmo jeito que o spring-boot-starter-parent faz com o Spring. -->
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>${aws.sdk.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Traz Spring MVC + Tomcat embutido + Jackson (JSON). E o que faz a
         aplicacao virar um servidor HTTP sem instalar nada por fora. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- JUnit 5, AssertJ, Mockito e o suporte de teste do Spring.
         Ainda sem testes escritos: entra agora para o passo 1 ja nascer
         com o alicerce pronto. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Cliente do DynamoDB. O netty-nio-client vem por padrao e nao e usado
         aqui: a API e sincrona, entao o cliente HTTP simples do JDK basta e
         evita carregar um servidor de rede inteiro a toa. -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>dynamodb</artifactId>
      <exclusions>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>apache5-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
    </dependency>

    <!-- Anotacoes de fatia de teste do MVC (@WebMvcTest). No Spring Boot 4 elas
         sairam do spring-boot-starter-test e viraram artefato por modulo. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Da o "mvn spring-boot:run" e empacota um jar executavel. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
